    "# preprocess text: tokenize, lemmatize, lowercase, remove stop words, remove punctuation\n",
    "import spacy\n",
    "import pandas as pd\n",
    "nlp = spacy.load('en_core_web_sm', disable=['ner', 'parser']) # use spaCy due to lemmatization issues with nltk\n",
    "\n",
    "df = pd.read_csv(\"MASTER_SAMPLED.csv\")\n",
    "\n",
    "\n",
    "def preprocess(text):\n",
    "    if not isinstance(text, str): \n",
    "      return \"\"\n",
    "    \n",
    "    doc = nlp(text)\n",
    "    clean_tokens = [\n",
    "          token.lemma_.lower() \n",
    "          for token in doc \n",
    "          if not token.is_stop and token.is_alpha and len(token.text) > 2\n",
    "      ]\n",
    "\n",
    "    return \" \".join(clean_tokens)\n",
    "\n",
    "df['clean_t'] = df['full_text'].apply(preprocess)\n",
    "p_df = df[['title','region','domain','date','clean_t']]\n",
    "p_df.to_csv(\"master_preprocess.csv\", index=False)"
   ]
  },
